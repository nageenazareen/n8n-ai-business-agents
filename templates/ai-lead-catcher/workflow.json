        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Received At": "={{ $now.setZone($('Business Settings').item.json.timezone).toFormat('yyyy-MM-dd HH:mm') }}",
            "Name": "={{ $('Lead Form').item.json[\"Name\"] }}",
            "Email": "={{ $('Lead Form').item.json[\"Email\"] }}",
            "Company": "={{ $('Lead Form').item.json[\"Company\"] }}",
            "Need": "={{ $('Lead Form').item.json[\"What do you need help with?\"] }}",
            "Budget": "={{ $('Lead Form').item.json[\"Budget\"] }}",
            "Score": "={{ $('AI Lead Scorer').item.json.output.score }}",
            "Service": "={{ $('AI Lead Scorer').item.json.output.service }}",
            "Summary": "={{ $('AI Lead Scorer').item.json.output.summary }}",
            "Reply Sent": "Yes"
          },
          "matchingColumns": [],
          "schema": [
